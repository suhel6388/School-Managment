# PostgreSQL connection string used by Prisma (server-side only).
# URL-encode special characters: @ -> %40, : -> %3A, / -> %2F, # -> %23
# Phase 2 schema targets PostgreSQL. Do not point this at the legacy MySQL database.
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/ice_school?schema=public"

# Secret used to sign the session cookie. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET="replace-with-a-long-random-secret"
