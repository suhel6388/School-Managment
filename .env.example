# MySQL connection string used by Prisma (server-side only).
# Prisma ORM 7 does not load .env automatically; prisma.config.ts imports
# dotenv/config, and the application's driver adapter reads this at runtime.
# URL-encode special characters: @ -> %40, : -> %3A, / -> %2F, # -> %23
# Use a NEW empty database for the multi-tenant schema; do not point this at
# the legacy single-tenant school_db.
DATABASE_URL="mysql://USER:PASSWORD@localhost:3306/ice_school_mt"

# Optional: connection string for the archived PostgreSQL variant. Used only
# when running commands with `--config prisma.postgres.config.ts`.
# POSTGRES_DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/ice_school?schema=public"

# Secret used to sign the session cookie. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET="replace-with-a-long-random-secret"

# ---------------------------------------------------------------------------
# Better Auth
# ---------------------------------------------------------------------------
# Separate secret for Better Auth. Generate with the same command above.
BETTER_AUTH_SECRET="replace-with-a-long-random-better-auth-secret"
BETTER_AUTH_URL="http://localhost:3000"
# Comma-separated additional origins allowed to call the auth API.
BETTER_AUTH_TRUSTED_ORIGINS="http://localhost:3000"

# ---------------------------------------------------------------------------
# Transactional email (verification + password reset)
# ---------------------------------------------------------------------------
# When SMTP is not configured in development, auth links are printed to the
# server log instead of being emailed. Production requires SMTP.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
BETTER_AUTH_EMAIL_FROM="ICE School Manager <no-reply@example.com>"
