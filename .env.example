# MySQL connection string used by Prisma (server-side only).
# URL-encode special characters: @ -> %40, : -> %3A, / -> %2F, # -> %23
DATABASE_URL="mysql://USER:PASSWORD@localhost:3306/ice20manager"

# Secret used to sign the session cookie. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET="replace-with-a-long-random-secret"
