# MySQL connection string used by Prisma (server-side only).
# Prisma ORM 7 does not load .env automatically; prisma.config.ts imports
# dotenv/config, and the application's driver adapter reads this at runtime.
# URL-encode special characters: @ -> %40, : -> %3A, / -> %2F, # -> %23
# Use a NEW empty database for the multi-tenant schema; do not point this at
# the legacy single-tenant school_db.
DATABASE_URL="mysql://USER:PASSWORD@localhost:3306/ice_school_mt"

# Optional: connection string for the archived PostgreSQL variant. Used only
# when running commands with `--config prisma.postgres.config.ts`.
# POSTGRES_DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/ice_school?schema=public"

# Secret used to sign the session cookie. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET="replace-with-a-long-random-secret"
