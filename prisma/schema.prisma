// ICE School Manager — Prisma schema (MySQL 8, shared database / shared schema multi-tenant)
// All monetary values use DECIMAL(12,2) to avoid floating point errors.
//
// The PostgreSQL variant of this schema is kept in prisma/postgres/schema.prisma
// for deployments that target PostgreSQL.
//
// Tenant rule:
//   - Every school-owned row carries `schoolId`.
//   - Every relation to another school-owned row uses the composite key
//     [schoolId, <fk>] -> [schoolId, id] so PostgreSQL itself rejects
//     cross-school references.
//   - Application code must derive `schoolId` from the authenticated
//     membership/session, never from request input.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ────────────────────────────── Tenancy / identity ──────────────────────────────

model School {
  id               String   @id @default(cuid())
  name             String   @db.VarChar(150)
  slug             String   @unique @db.VarChar(80)
  email            String?  @db.VarChar(150)
  phone            String?  @db.VarChar(40)
  address          String?  @db.Text
  logo             String?  @db.Text
  status           String   @default("active") @db.VarChar(20)
  subscriptionPlan String   @default("free") @db.VarChar(40)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  setting              Setting?
  academicSessions     AcademicSession[]
  classes              SchoolClass[]
  sections             Section[]
  classSections        ClassSection[]
  subjects             Subject[]
  subjectGroups        SubjectGroup[]
  subjectGroupSections SubjectGroupSection[]
  subjectGroupSubjects SubjectGroupSubject[]
  studentCategories    StudentCategory[]
  studentHouses        StudentHouse[]
  disableReasons       DisableReason[]
  students             Student[]
  counters             Counter[]
  feeGroups            FeeGroup[]
  feeTypes             FeeType[]
  feeDiscounts         FeeDiscount[]
  feeMasters           FeeMaster[]
  payments             Payment[]
  carryForwards        CarryForward[]
  bankPayments         BankPayment[]
  feeReminders         FeeReminder[]
  departments          Department[]
  designations         Designation[]
  leaveTypes           LeaveType[]
  staff                Staff[]
  staffLeaves          StaffLeave[]
  staffRatings         StaffRating[]
  payrolls             Payroll[]
  staffAttendance      StaffAttendance[]
  studentAttendance    StudentAttendance[]
  studentLeaves        StudentLeave[]
  frontOfficeSetups    FrontOfficeSetup[]
  enquiries            Enquiry[]
  visitors             Visitor[]
  phoneCalls           PhoneCall[]
  postalDispatches     PostalDispatch[]
  postalReceives       PostalReceive[]
  complaints           Complaint[]
  onlineAdmissions     OnlineAdmission[]
  multiClasses         MultiClass[]
  expenseHeads         ExpenseHead[]
  expenses             Expense[]
  examGroups           ExamGroup[]
  examSchedules        ExamSchedule[]
  examResults          ExamResult[]
  grades               Grade[]
  divisions            Division[]
  admitTemplate        AdmitTemplate?
  markTemplate         MarkTemplate?
  onlineExams          OnlineExam[]
  questions            Question[]
  onlineExamResults    OnlineExamResult[]
  lessons              Lesson[]
  topics               Topic[]
  lessonPlans          LessonPlan[]
  notices              Notice[]
  emailTemplates       EmailTemplate[]
  smsTemplates         SmsTemplate[]
  scheduledMessages    ScheduledMessage[]
  messageLogs          MessageLog[]
  contentTypes         ContentType[]
  contents             Content[]
  homework             Homework[]
  homeworkSubmissions  HomeworkSubmission[]
  schoolEvents         SchoolEvent[]
  books                Book[]
  libraryMembers       LibraryMember[]
  bookIssues           BookIssue[]
  itemCategories       ItemCategory[]
  itemStores           ItemStore[]
  itemSuppliers        ItemSupplier[]
  items                Item[]
  itemStocks           ItemStock[]
  itemIssues           ItemIssue[]
  transportRoutes      TransportRoute[]
  vehicles             Vehicle[]
  pickupPoints         PickupPoint[]
  routePickups         RoutePickup[]
  vehicleAssignments   VehicleAssignment[]
  assignmentVehicles   AssignmentVehicle[]
  transportFees        TransportFee[]
  transportAssignments TransportAssignment[]
  hostels              Hostel[]
  roomTypes            RoomType[]
  rooms                Room[]
  hostelAllocations    HostelAllocation[]
  certificateTemplates CertificateTemplate[]
  idCardTemplate       IdCardTemplate?
  alumni               Alumni[]
  alumniEvents         AlumniEvent[]
  customFields         CustomField[]
  languages            Language[]
  roles                Role[]
  appUsers             AppUser[]
  auditLogs            AuditLog[]
  userLogs             UserLog[]
  memberships          SchoolMembership[]

  @@index([status])
  @@map("schools")
}

// Better Auth core: `user`
model User {
  id            String   @id
  name          String   @db.VarChar(150)
  email         String   @unique @db.VarChar(180)
  emailVerified Boolean  @default(false)
  image         String?  @db.Text
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  sessions    Session[]
  accounts    Account[]
  memberships SchoolMembership[]

  @@map("user")
}

// Better Auth core: `session`
model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique @db.VarChar(255)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?  @db.VarChar(64)
  userAgent String?  @db.Text
  userId    String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

// Better Auth core: `account`
model Account {
  id                    String    @id
  accountId             String    @db.VarChar(180)
  providerId            String    @db.VarChar(80)
  userId                String
  accessToken           String?   @db.Text
  refreshToken          String?   @db.Text
  idToken               String?   @db.Text
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?   @db.Text
  password              String?   @db.Text
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("account")
}

// Better Auth core: `verification`
model Verification {
  id         String   @id
  identifier String   @db.VarChar(255)
  value      String   @db.Text
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model SchoolMembership {
  id        String   @id @default(cuid())
  schoolId  String
  userId    String
  role      String   @default("member") @db.VarChar(40)
  status    String   @default("active") @db.VarChar(20)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([schoolId, userId])
  @@index([schoolId, status])
  @@index([userId])
  @@map("school_memberships")
}

// ────────────────────────────── School / settings ──────────────────────────────

model Setting {
  id           Int       @id @default(autoincrement())
  schoolId     String    @unique
  name         String    @db.VarChar(150)
  address      String?   @db.Text
  phone        String?   @db.VarChar(40)
  email        String?   @db.VarChar(150)
  session      String    @default("2026-27") @db.VarChar(20)
  headerText   String?   @db.VarChar(150)
  footerText   String?   @db.Text
  captcha      Boolean   @default(false)
  waMessage    String?   @db.Text
  fileTypes    String?   @db.Text
  planName     String?   @db.VarChar(60)
  planExpires  DateTime? @db.Date
  profilePhone Boolean   @default(true)
  profileAddr  Boolean   @default(true)
  profileEmail Boolean   @default(true)
  profilePhoto Boolean   @default(false)
  updatedAt    DateTime  @updatedAt

  school School @relation(fields: [schoolId], references: [id])

  @@map("settings")
}

model AcademicSession {
  id        String   @id @default(cuid())
  schoolId  String
  name      String   @db.VarChar(20)
  createdAt DateTime @default(now())

  school School @relation(fields: [schoolId], references: [id])

  @@unique([schoolId, name])
  @@unique([schoolId, id])
  @@index([schoolId])
  @@map("academic_sessions")
}

model SchoolClass {
  id        String   @id @default(cuid())
  schoolId  String
  name      String   @db.VarChar(60)
  order     Int      @default(0)
  createdAt DateTime @default(now())

  school School @relation(fields: [schoolId], references: [id])

  sections         ClassSection[]
  students         Student[]
  feeMasters       FeeMaster[]
  enquiries        Enquiry[]
  onlineAdmissions OnlineAdmission[]
  multiClasses     MultiClass[]
  examSchedules    ExamSchedule[]
  lessons          Lesson[]
  lessonPlans      LessonPlan[]
  questions        Question[]
  onlineExams      OnlineExam[]
  homework         Homework[]
  contents         Content[]
  subjectGroups    SubjectGroup[]

  @@unique([schoolId, id])
  @@index([schoolId])
  @@index([order])
  @@map("classes")
}

model Section {
  id        String   @id @default(cuid())
  schoolId  String
  name      String   @db.VarChar(30)
  createdAt DateTime @default(now())

  school School @relation(fields: [schoolId], references: [id])

  classes       ClassSection[]
  students      Student[]
  multiClasses  MultiClass[]
  homework      Homework[]
  subjectGroups SubjectGroupSection[]

  @@unique([schoolId, id])
  @@index([schoolId])
  @@map("sections")
}

model ClassSection {
  classId   String
  sectionId String
  schoolId  String

  class   SchoolClass @relation(fields: [schoolId, classId], references: [schoolId, id], onDelete: Cascade)
  section Section     @relation(fields: [schoolId, sectionId], references: [schoolId, id], onDelete: Cascade)
  school  School      @relation(fields: [schoolId], references: [id])

  @@id([classId, sectionId])
  @@index([schoolId])
  @@map("class_sections")
}

model Subject {
  id        String   @id @default(cuid())
  schoolId  String
  name      String   @db.VarChar(80)
  code      String?  @db.VarChar(20)
  type      String   @default("Theory") @db.VarChar(20)
  createdAt DateTime @default(now())

  school School @relation(fields: [schoolId], references: [id])

  examSchedules     ExamSchedule[]
  lessons           Lesson[]
  lessonPlans       LessonPlan[]
  questions         Question[]
  onlineExams       OnlineExam[]
  homework          Homework[]
  subjectGroupItems SubjectGroupSubject[]

  @@unique([schoolId, id])
  @@index([schoolId])
  @@index([schoolId, name])
  @@map("subjects")
}

model SubjectGroup {
  id        String   @id @default(cuid())
  schoolId  String
  name      String   @db.VarChar(80)
  classId   String?
  createdAt DateTime @default(now())

  school School       @relation(fields: [schoolId], references: [id])
  class  SchoolClass? @relation(fields: [schoolId, classId], references: [schoolId, id], onDelete: Restrict)

  sections SubjectGroupSection[]
  subjects SubjectGroupSubject[]

  @@unique([schoolId, id])
  @@index([schoolId])
  @@map("subject_groups")
}

model SubjectGroupSection {
  groupId   String
  sectionId String
  schoolId  String

  group   SubjectGroup @relation(fields: [schoolId, groupId], references: [schoolId, id], onDelete: Cascade)
  section Section      @relation(fields: [schoolId, sectionId], references: [schoolId, id], onDelete: Cascade)
  school  School       @relation(fields: [schoolId], references: [id])

  @@id([groupId, sectionId])
  @@index([schoolId])
  @@map("subject_group_sections")
}

model SubjectGroupSubject {
  groupId   String
  subjectId String
  schoolId  String

  group   SubjectGroup @relation(fields: [schoolId, groupId], references: [schoolId, id], onDelete: Cascade)
  subject Subject      @relation(fields: [schoolId, subjectId], references: [schoolId, id], onDelete: Cascade)
  school  School       @relation(fields: [schoolId], references: [id])

  @@id([groupId, subjectId])
  @@index([schoolId])
  @@map("subject_group_subjects")
}

model StudentCategory {
  id        String   @id @default(cuid())
  schoolId  String
  name      String   @db.VarChar(60)
  desc      String?  @db.Text
  createdAt DateTime @default(now())

  school   School    @relation(fields: [schoolId], references: [id])
  students Student[]

  @@unique([schoolId, name])
  @@unique([schoolId, id])
  @@index([schoolId])
  @@map("student_categories")
}

model StudentHouse {
  id       String    @id @default(cuid())
  schoolId String
  name     String    @db.VarChar(60)
  desc     String?   @db.Text
  students Student[]

  school School @relation(fields: [schoolId], references: [id])

  @@unique([schoolId, name])
  @@unique([schoolId, id])
  @@index([schoolId])
  @@map("student_houses")
}

model DisableReason {
  id       String    @id @default(cuid())
  schoolId String
  name     String    @db.VarChar(120)
  desc     String?   @db.Text
  students Student[] @relation("StudentDisableReason")

  school School @relation(fields: [schoolId], references: [id])

  @@unique([schoolId, name])
  @@unique([schoolId, id])
  @@index([schoolId])
  @@map("disable_reasons")
}

// ────────────────────────────── Students ──────────────────────────────

model Student {
  id             String    @id @default(cuid())
  schoolId       String
  admNo          String    @db.VarChar(32)
  rollNo         String?   @db.VarChar(20)
  name           String    @db.VarChar(120)
  gender         String    @default("Male") @db.VarChar(16)
  classId        String?
  sectionId      String?
  dob            DateTime? @db.Date
  admDate        DateTime  @default(dbgenerated("(curdate())")) @db.Date
  categoryId     String?
  houseId        String?
  disReasonId    String?
  father         String?   @db.VarChar(120)
  mother         String?   @db.VarChar(120)
  phone          String?   @db.VarChar(20)
  email          String?   @db.VarChar(150)
  address        String?   @db.Text
  photo          String?   @db.Text
  status         String    @default("active") @db.VarChar(16)
  portalPassword String?   @db.VarChar(60)
  custom         Json?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  school    School           @relation(fields: [schoolId], references: [id])
  class     SchoolClass?     @relation(fields: [schoolId, classId], references: [schoolId, id], onDelete: Restrict)
  section   Section?         @relation(fields: [schoolId, sectionId], references: [schoolId, id], onDelete: Restrict)
  category  StudentCategory? @relation(fields: [schoolId, categoryId], references: [schoolId, id], onDelete: Restrict)
  house     StudentHouse?    @relation(fields: [schoolId, houseId], references: [schoolId, id], onDelete: Restrict)
  disReason DisableReason?   @relation("StudentDisableReason", fields: [schoolId, disReasonId], references: [schoolId, id], onDelete: Restrict)

  payments          Payment[]
  carryForwards     CarryForward[]
  bankPayments      BankPayment[]
  attendance        StudentAttendance[]
  leaves            StudentLeave[]
  multiClasses      MultiClass[]
  examResults       ExamResult[]
  onlineResults     OnlineExamResult[]
  homeworkSubs      HomeworkSubmission[]
  hostelAllocations HostelAllocation[]
  transportAssign   TransportAssignment[]

  @@unique([schoolId, admNo])
  @@unique([schoolId, id])
  @@index([schoolId])
  @@index([schoolId, status])
  @@index([classId, sectionId, status])
  @@index([name])
  @@index([phone])
  @@map("students")
}

model Counter {
  schoolId String
  key      String @db.VarChar(30)
  value    Int    @default(0)

  school School @relation(fields: [schoolId], references: [id])

  @@id([schoolId, key])
  @@map("counters")
}

// ────────────────────────────── Fees ──────────────────────────────

model FeeGroup {
  id        String      @id @default(cuid())
  schoolId  String
  name      String      @db.VarChar(80)
  desc      String?     @db.Text
  createdAt DateTime    @default(now())
  masters   FeeMaster[]

  school School @relation(fields: [schoolId], references: [id])

  @@unique([schoolId, name])
  @@unique([schoolId, id])
  @@index([schoolId])
  @@map("fee_groups")
}

model FeeType {
  id       String      @id @default(cuid())
  schoolId String
  name     String      @db.VarChar(80)
  code     String?     @db.VarChar(20)
  desc     String?     @db.Text
  masters  FeeMaster[]

  school School @relation(fields: [schoolId], references: [id])

  @@unique([schoolId, id])
  @@index([schoolId])
  @@map("fee_types")
}

model FeeDiscount {
  id       String  @id @default(cuid())
  schoolId String
  name     String  @db.VarChar(100)
  code     String? @db.VarChar(20)
  type     String  @default("Fixed") @db.VarChar(12)
  amount   Decimal @default(0) @db.Decimal(12, 2)

  school School @relation(fields: [schoolId], references: [id])

  @@unique([schoolId, id])
  @@index([schoolId])
  @@map("fee_discounts")
}

model FeeMaster {
  id        String    @id @default(cuid())
  schoolId  String
  groupId   String
  typeId    String
  classId   String
  label     String?   @db.VarChar(80)
  amount    Decimal   @db.Decimal(12, 2)
  due       DateTime? @db.Date
  fine      Decimal   @default(0) @db.Decimal(12, 2)
  createdAt DateTime  @default(now())

  school School      @relation(fields: [schoolId], references: [id])
  group  FeeGroup    @relation(fields: [schoolId, groupId], references: [schoolId, id], onDelete: Restrict)
  type   FeeType     @relation(fields: [schoolId, typeId], references: [schoolId, id], onDelete: Restrict)
  class  SchoolClass @relation(fields: [schoolId, classId], references: [schoolId, id], onDelete: Restrict)

  @@unique([schoolId, id])
  @@index([schoolId])
  @@index([classId])
  @@map("fee_masters")
}

model Payment {
  id        String   @id @default(cuid())
  schoolId  String
  rc        String   @db.VarChar(32)
  studentId String
  feeKey    String   @db.VarChar(80)
  amount    Decimal  @db.Decimal(12, 2)
  discount  Decimal  @default(0) @db.Decimal(12, 2)
  fine      Decimal  @default(0) @db.Decimal(12, 2)
  mode      String   @db.VarChar(30)
  date      DateTime @db.Date
  note      String?  @db.Text
  createdAt DateTime @default(now())

  school  School  @relation(fields: [schoolId], references: [id])
  student Student @relation(fields: [schoolId, studentId], references: [schoolId, id], onDelete: Cascade)

  @@unique([schoolId, rc])
  @@unique([schoolId, id])
  @@index([schoolId])
  @@index([schoolId, date])
  @@index([studentId, feeKey])
  @@index([date])
  @@map("payments")
}

model CarryForward {
  id          String    @id @default(cuid())
  schoolId    String
  studentId   String
  fromSession String    @db.VarChar(20)
  amount      Decimal   @db.Decimal(12, 2)
  due         DateTime? @db.Date
  createdAt   DateTime  @default(now())

  school  School  @relation(fields: [schoolId], references: [id])
  student Student @relation(fields: [schoolId, studentId], references: [schoolId, id], onDelete: Cascade)

  @@unique([schoolId, id])
  @@index([schoolId])
  @@index([studentId])
  @@map("carry_forwards")
}

model BankPayment {
  id        String   @id @default(cuid())
  schoolId  String
  studentId String
  amount    Decimal  @db.Decimal(12, 2)
  bank      String?  @db.VarChar(120)
  ref       String   @db.VarChar(80)
  date      DateTime @default(dbgenerated("(curdate())")) @db.Date
  status    String   @default("Pending") @db.VarChar(20)
  createdAt DateTime @default(now())

  school  School  @relation(fields: [schoolId], references: [id])
  student Student @relation(fields: [schoolId, studentId], references: [schoolId, id], onDelete: Cascade)

  @@unique([schoolId, id])
  @@index([schoolId])
  @@index([status])
  @@map("bank_payments")
}

model FeeReminder {
  id       String  @id @default(cuid())
  schoolId String
  name     String  @db.VarChar(120)
  kind     String  @db.VarChar(20)
  days     Int     @default(0)
  sms      Boolean @default(true)
  email    Boolean @default(false)
  wa       Boolean @default(false)
  active   Boolean @default(true)

  school School @relation(fields: [schoolId], references: [id])

  @@unique([schoolId, id])
  @@index([schoolId])
  @@map("fee_reminders")
}

// ────────────────────────────── HR ──────────────────────────────

model Department {
  id       String  @id @default(cuid())
  schoolId String
  name     String  @db.VarChar(80)
  desc     String? @db.Text
  staff    Staff[]

  school School @relation(fields: [schoolId], references: [id])

  @@unique([schoolId, name])
  @@unique([schoolId, id])
  @@index([schoolId])
  @@map("departments")
}

model Designation {
  id       String  @id @default(cuid())
  schoolId String
  name     String  @db.VarChar(80)
  desc     String? @db.Text
  staff    Staff[]

  school School @relation(fields: [schoolId], references: [id])

  @@unique([schoolId, name])
  @@unique([schoolId, id])
  @@index([schoolId])
  @@map("designations")
}

model LeaveType {
  id          String       @id @default(cuid())
  schoolId    String
  name        String       @db.VarChar(80)
  days        Int          @default(0)
  staffLeaves StaffLeave[]

  school School @relation(fields: [schoolId], references: [id])

  @@unique([schoolId, id])
  @@index([schoolId])
  @@map("leave_types")
}

model Staff {
  id        String    @id @default(cuid())
  schoolId  String
  empId     String    @db.VarChar(32)
  name      String    @db.VarChar(120)
  desigId   String?
  deptId    String?
  gender    String?   @db.VarChar(16)
  phone     String?   @db.VarChar(20)
  email     String?   @db.VarChar(150)
  joinDate  DateTime? @db.Date
  basic     Decimal   @default(0) @db.Decimal(12, 2)
  status    String    @default("active") @db.VarChar(16)
  address   String?   @db.Text
  qual      String?   @db.VarChar(120)
  createdAt DateTime  @default(now())

  school      School       @relation(fields: [schoolId], references: [id])
  designation Designation? @relation(fields: [schoolId, desigId], references: [schoolId, id], onDelete: Restrict)
  department  Department?  @relation(fields: [schoolId, deptId], references: [schoolId, id], onDelete: Restrict)

  leaves      StaffLeave[]
  ratings     StaffRating[]
  payrolls    Payroll[]
  attendance  StaffAttendance[]
  lessonPlans LessonPlan[]
  itemIssues  ItemIssue[]

  @@unique([schoolId, empId])
  @@unique([schoolId, id])
  @@index([schoolId])
  @@index([status])
  @@map("staff")
}

model StaffLeave {
  id        String   @id @default(cuid())
  schoolId  String
  staffId   String
  typeId    String?
  from      DateTime @db.Date
  to        DateTime @db.Date
  reason    String?  @db.Text
  status    String   @default("Pending") @db.VarChar(20)
  createdAt DateTime @default(now())

  school School     @relation(fields: [schoolId], references: [id])
  staff  Staff      @relation(fields: [schoolId, staffId], references: [schoolId, id], onDelete: Cascade)
  type   LeaveType? @relation(fields: [schoolId, typeId], references: [schoolId, id], onDelete: Restrict)

  @@unique([schoolId, id])
  @@index([schoolId])
  @@index([status])
  @@map("staff_leaves")
}

model StaffRating {
  id        String   @id @default(cuid())
  schoolId  String
  staffId   String
  rating    Int
  by        String?  @db.VarChar(80)
  comment   String?  @db.Text
  date      DateTime @default(dbgenerated("(curdate())")) @db.Date
  createdAt DateTime @default(now())

  school School @relation(fields: [schoolId], references: [id])
  staff  Staff  @relation(fields: [schoolId, staffId], references: [schoolId, id], onDelete: Cascade)

  @@unique([schoolId, id])
  @@index([schoolId])
  @@map("staff_ratings")
}

model Payroll {
  id        String    @id @default(cuid())
  schoolId  String
  staffId   String
  month     String    @db.VarChar(7)
  basic     Decimal   @db.Decimal(12, 2)
  allow     Decimal   @default(0) @db.Decimal(12, 2)
  deduct    Decimal   @default(0) @db.Decimal(12, 2)
  net       Decimal   @db.Decimal(12, 2)
  status    String    @default("Generated") @db.VarChar(20)
  paidDate  DateTime? @db.Date
  mode      String?   @db.VarChar(30)
  createdAt DateTime  @default(now())

  school School @relation(fields: [schoolId], references: [id])
