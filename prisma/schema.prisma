  @@index([schoolId])
  @@index([kind, refId])
  @@map("library_members")
}

model BookIssue {
  id        String    @id @default(cuid())
  schoolId  String
  memberId  String
  bookId    String
  issue     DateTime  @db.Date
  due       DateTime  @db.Date
  ret       DateTime? @db.Date
  createdAt DateTime  @default(now())

  school School        @relation(fields: [schoolId], references: [id])
  member LibraryMember @relation(fields: [schoolId, memberId], references: [schoolId, id], onDelete: Cascade)
  book   Book          @relation(fields: [schoolId, bookId], references: [schoolId, id], onDelete: Restrict)

  @@unique([schoolId, id])
  @@index([schoolId])
  @@index([bookId, ret])
  @@map("book_issues")
}

// ────────────────────────────── Inventory ──────────────────────────────

model ItemCategory {
  id       String  @id @default(cuid())
  schoolId String
  name     String  @db.VarChar(80)
  desc     String? @db.Text
  items    Item[]

  school School @relation(fields: [schoolId], references: [id])

  @@unique([schoolId, name])
  @@unique([schoolId, id])
  @@index([schoolId])
  @@map("item_categories")
}

model ItemStore {
  id       String      @id @default(cuid())
  schoolId String
  name     String      @db.VarChar(100)
  code     String?     @db.VarChar(20)
  desc     String?     @db.Text
  stock    ItemStock[]

  school School @relation(fields: [schoolId], references: [id])

  @@unique([schoolId, id])
  @@index([schoolId])
  @@map("item_stores")
}

model ItemSupplier {
  id       String      @id @default(cuid())
  schoolId String
  name     String      @db.VarChar(150)
  contact  String?     @db.VarChar(120)
  phone    String?     @db.VarChar(20)
  address  String?     @db.Text
  desc     String?     @db.Text
  stock    ItemStock[]

  school School @relation(fields: [schoolId], references: [id])

  @@unique([schoolId, id])
  @@index([schoolId])
  @@map("item_suppliers")
}

model Item {
  id       String  @id @default(cuid())
  schoolId String
  name     String  @db.VarChar(150)
  catId    String
  unit     String? @db.VarChar(30)
  desc     String? @db.Text

  school   School       @relation(fields: [schoolId], references: [id])
  category ItemCategory @relation(fields: [schoolId, catId], references: [schoolId, id], onDelete: Restrict)
  stock    ItemStock[]
  issues   ItemIssue[]

  @@unique([schoolId, id])
  @@index([schoolId])
  @@map("items")
}

model ItemStock {
  id         String   @id @default(cuid())
  schoolId   String
  itemId     String
  supId      String?
  storeId    String?
  qty        Int      @default(0)
  price      Decimal  @default(0) @db.Decimal(12, 2)
  date       DateTime @default(dbgenerated("(curdate())")) @db.Date
  purchaseNo String?  @db.VarChar(60)
  desc       String?  @db.Text
  createdAt  DateTime @default(now())

  school   School        @relation(fields: [schoolId], references: [id])
  item     Item          @relation(fields: [schoolId, itemId], references: [schoolId, id], onDelete: Cascade)
  supplier ItemSupplier? @relation(fields: [schoolId, supId], references: [schoolId, id], onDelete: Restrict)
  store    ItemStore?    @relation(fields: [schoolId, storeId], references: [schoolId, id], onDelete: Restrict)

  @@unique([schoolId, id])
  @@index([schoolId])
  @@index([itemId])
  @@map("item_stock")
}

model ItemIssue {
  id        String    @id @default(cuid())
  schoolId  String
  itemId    String
  staffId   String?
  qty       Int
  issue     DateTime  @db.Date
  ret       DateTime? @db.Date
  status    String    @default("Issued") @db.VarChar(20)
  note      String?   @db.Text
  createdAt DateTime  @default(now())

  school School @relation(fields: [schoolId], references: [id])
  item   Item   @relation(fields: [schoolId, itemId], references: [schoolId, id], onDelete: Cascade)
  staff  Staff? @relation(fields: [schoolId, staffId], references: [schoolId, id], onDelete: Restrict)

  @@unique([schoolId, id])
  @@index([schoolId])
  @@index([itemId, status])
  @@map("item_issues")
}

// ────────────────────────────── Transport ──────────────────────────────

model TransportRoute {
  id        String   @id @default(cuid())
  schoolId  String
  name      String   @db.VarChar(120)
  desc      String?  @db.Text
  createdAt DateTime @default(now())

  school School @relation(fields: [schoolId], references: [id])

  pickups     RoutePickup[]
  assignments VehicleAssignment[]
  students    TransportAssignment[]

  @@unique([schoolId, id])
  @@index([schoolId])
  @@map("transport_routes")
}

model Vehicle {
  id       String  @id @default(cuid())
  schoolId String
  number   String  @db.VarChar(40)
  model    String? @db.VarChar(80)
  year     String? @db.VarChar(10)
  driver   String? @db.VarChar(120)
  phone    String? @db.VarChar(20)
  licence  String? @db.VarChar(40)
  capacity Int     @default(0)

  school      School              @relation(fields: [schoolId], references: [id])
  assignments AssignmentVehicle[]

  @@unique([schoolId, number])
  @@unique([schoolId, id])
  @@index([schoolId])
  @@map("vehicles")
}

model PickupPoint {
  id       String @id @default(cuid())
  schoolId String
  name     String @db.VarChar(150)

  school   School                @relation(fields: [schoolId], references: [id])
  routes   RoutePickup[]
  fees     TransportFee[]
  students TransportAssignment[]

  @@unique([schoolId, id])
  @@index([schoolId])
  @@map("pickup_points")
}

model RoutePickup {
  id       String  @id @default(cuid())
  schoolId String
  routeId  String
  pickupId String
  time     String? @db.VarChar(5)

  school School         @relation(fields: [schoolId], references: [id])
  route  TransportRoute @relation(fields: [schoolId, routeId], references: [schoolId, id], onDelete: Cascade)
  pickup PickupPoint    @relation(fields: [schoolId, pickupId], references: [schoolId, id], onDelete: Cascade)

  @@unique([schoolId, routeId, pickupId])
  @@unique([schoolId, id])
  @@index([schoolId])
  @@map("route_pickups")
}

model VehicleAssignment {
  id       String @id @default(cuid())
  schoolId String
  routeId  String

  school   School              @relation(fields: [schoolId], references: [id])
  route    TransportRoute      @relation(fields: [schoolId, routeId], references: [schoolId, id], onDelete: Cascade)
  vehicles AssignmentVehicle[]

  @@unique([schoolId, id])
  @@index([schoolId])
  @@map("vehicle_assignments")
}

model AssignmentVehicle {
  assignmentId String
  vehicleId    String
  schoolId     String

  assignment VehicleAssignment @relation(fields: [schoolId, assignmentId], references: [schoolId, id], onDelete: Cascade)
  vehicle    Vehicle           @relation(fields: [schoolId, vehicleId], references: [schoolId, id], onDelete: Cascade)
  school     School            @relation(fields: [schoolId], references: [id])

  @@id([assignmentId, vehicleId])
  @@index([schoolId])
  @@map("assignment_vehicles")
}

model TransportFee {
  id         String  @id @default(cuid())
  schoolId   String
  pickupId   String
  monthlyFee Decimal @db.Decimal(12, 2)
  months     Int     @default(10)
  fine       Decimal @default(0) @db.Decimal(12, 2)

  school School      @relation(fields: [schoolId], references: [id])
  pickup PickupPoint @relation(fields: [schoolId, pickupId], references: [schoolId, id], onDelete: Cascade)

  @@unique([schoolId, pickupId])
  @@unique([schoolId, id])
  @@index([schoolId])
  @@map("transport_fees")
}

model TransportAssignment {
  id        String    @id @default(cuid())
  schoolId  String
  studentId String
  routeId   String
  pickupId  String
  due       DateTime? @db.Date
  createdAt DateTime  @default(now())

  school  School         @relation(fields: [schoolId], references: [id])
  student Student        @relation(fields: [schoolId, studentId], references: [schoolId, id], onDelete: Cascade)
  route   TransportRoute @relation(fields: [schoolId, routeId], references: [schoolId, id], onDelete: Restrict)
  pickup  PickupPoint    @relation(fields: [schoolId, pickupId], references: [schoolId, id], onDelete: Restrict)

  @@unique([schoolId, studentId, pickupId])
  @@unique([schoolId, id])
  @@index([schoolId])
  @@map("transport_assignments")
}

// ────────────────────────────── Hostel ──────────────────────────────

model Hostel {
  id       String  @id @default(cuid())
  schoolId String
  name     String  @db.VarChar(150)
  type     String? @db.VarChar(20)
  address  String? @db.VarChar(200)
  intake   Int     @default(0)
  desc     String? @db.Text

  school School @relation(fields: [schoolId], references: [id])

  rooms Room[]

  @@unique([schoolId, id])
  @@index([schoolId])
  @@map("hostels")
}

model RoomType {
  id       String  @id @default(cuid())
  schoolId String
  name     String  @db.VarChar(60)
  desc     String? @db.Text

  school School @relation(fields: [schoolId], references: [id])

  rooms Room[]

  @@unique([schoolId, name])
  @@unique([schoolId, id])
  @@index([schoolId])
  @@map("room_types")
}

model Room {
  id       String  @id @default(cuid())
  schoolId String
  hostelId String
  typeId   String
  roomNo   String  @db.VarChar(30)
  beds     Int     @default(1)
  cost     Decimal @default(0) @db.Decimal(12, 2)
  desc     String? @db.Text

  school School   @relation(fields: [schoolId], references: [id])
  hostel Hostel   @relation(fields: [schoolId, hostelId], references: [schoolId, id], onDelete: Cascade)
  type   RoomType @relation(fields: [schoolId, typeId], references: [schoolId, id], onDelete: Restrict)

  allocations HostelAllocation[]

  @@unique([schoolId, hostelId, roomNo])
  @@unique([schoolId, id])
  @@index([schoolId])
  @@map("rooms")
}

model HostelAllocation {
  id        String   @id @default(cuid())
  schoolId  String
  studentId String
  roomId    String
  date      DateTime @default(dbgenerated("(curdate())")) @db.Date
  createdAt DateTime @default(now())

  school  School  @relation(fields: [schoolId], references: [id])
  student Student @relation(fields: [schoolId, studentId], references: [schoolId, id], onDelete: Cascade)
  room    Room    @relation(fields: [schoolId, roomId], references: [schoolId, id], onDelete: Cascade)

  @@unique([schoolId, studentId])
  @@unique([schoolId, id])
  @@index([schoolId])
  @@map("hostel_allocations")
}

// ────────────────────────────── Certificates / alumni ──────────────────────────────

model CertificateTemplate {
  id       String  @id @default(cuid())
  schoolId String
  name     String  @db.VarChar(120)
  body     String  @db.Text
  foot     String? @db.VarChar(80)

  school School @relation(fields: [schoolId], references: [id])

  @@unique([schoolId, id])
  @@index([schoolId])
  @@map("certificate_templates")
}

model IdCardTemplate {
  id        Int      @id @default(autoincrement())
  schoolId  String   @unique
  color     String   @default("#1d3a8a") @db.VarChar(20)
  validity  String?  @db.VarChar(80)
  updatedAt DateTime @updatedAt

  school School @relation(fields: [schoolId], references: [id])

  @@map("id_card_templates")
}

model Alumni {
  id         String  @id @default(cuid())
  schoolId   String
  name       String  @db.VarChar(150)
  year       String? @db.VarChar(10)
  occupation String? @db.VarChar(120)
  phone      String? @db.VarChar(20)
  email      String? @db.VarChar(150)
  address    String? @db.Text
  note       String? @db.Text

  school School @relation(fields: [schoolId], references: [id])

  @@unique([schoolId, id])
  @@index([schoolId])
  @@map("alumni")
}

model AlumniEvent {
  id       String    @id @default(cuid())
  schoolId String
  title    String    @db.VarChar(150)
  from     DateTime  @db.Date
  to       DateTime? @db.Date
  place    String?   @db.VarChar(150)
  note     String?   @db.Text

  school School @relation(fields: [schoolId], references: [id])

  @@unique([schoolId, id])
  @@index([schoolId])
  @@map("alumni_events")
}

// ────────────────────────────── System ──────────────────────────────

model CustomField {
  id       String @id @default(cuid())
  schoolId String
  name     String @db.VarChar(80)
  for      String @default("Student") @db.VarChar(30)
  type     String @default("Text") @db.VarChar(20)

  school School @relation(fields: [schoolId], references: [id])

  @@unique([schoolId, id])
  @@index([schoolId])
  @@map("custom_fields")
}

model Language {
  id       String  @id @default(cuid())
  schoolId String
  name     String  @db.VarChar(60)
  code     String  @db.VarChar(10)
  enabled  Boolean @default(true)

  school School @relation(fields: [schoolId], references: [id])

  @@unique([schoolId, code])
  @@unique([schoolId, id])
  @@index([schoolId])
  @@map("languages")
}

model Role {
  id       String    @id @default(cuid())
  schoolId String
  name     String    @db.VarChar(40)
  perms    Json
  users    AppUser[]

  school School @relation(fields: [schoolId], references: [id])

  @@unique([schoolId, name])
  @@unique([schoolId, id])
  @@index([schoolId])
  @@map("roles")
}

model AppUser {
  id           String   @id @default(cuid())
  schoolId     String
  name         String   @db.VarChar(120)
  username     String   @db.VarChar(64)
  passwordHash String   @db.VarChar(200)
  role         String   @db.VarChar(40)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())

  school  School @relation(fields: [schoolId], references: [id])
  roleRef Role   @relation(fields: [schoolId, role], references: [schoolId, name], onUpdate: Cascade, onDelete: Restrict)

  @@unique([schoolId, username])
  @@unique([schoolId, id])
  @@index([schoolId])
  @@map("app_users")
}

model AuditLog {
  id          String   @id @default(cuid())
  schoolId    String
  time        DateTime @default(now())
  user        String   @db.VarChar(64)
  act         String   @db.VarChar(40)
  entity      String   @db.VarChar(80)
  description String?  @db.Text

  school School @relation(fields: [schoolId], references: [id])

  @@unique([schoolId, id])
  @@index([schoolId])
  @@index([time])
  @@map("audit_logs")
}

model UserLog {
  id       String   @id @default(cuid())
  schoolId String
  time     DateTime @default(now())
  user     String   @db.VarChar(64)
  act      String   @db.VarChar(80)

  school School @relation(fields: [schoolId], references: [id])

  @@unique([schoolId, id])
  @@index([schoolId])
  @@index([time])
  @@map("user_logs")
}
