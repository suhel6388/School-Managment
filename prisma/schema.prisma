  name       String  @db.VarChar(150)
  year       String? @db.VarChar(10)
  occupation String? @db.VarChar(120)
  phone      String? @db.VarChar(20)
  email      String? @db.VarChar(150)
  address    String? @db.Text
  note       String? @db.Text

  @@map("alumni")
}

model AlumniEvent {
  id    String    @id @default(cuid())
  title String    @db.VarChar(150)
  from  DateTime  @db.Date
  to    DateTime? @db.Date
  place String?   @db.VarChar(150)
  note  String?   @db.Text

  @@map("alumni_events")
}

// ────────────────────────────── System ──────────────────────────────

model CustomField {
  id   String @id @default(cuid())
  name String @db.VarChar(80)
  for  String @default("Student") @db.VarChar(30)
  type String @default("Text") @db.VarChar(20)

  @@map("custom_fields")
}

model Language {
  id      String  @id @default(cuid())
  name    String  @db.VarChar(60)
  code    String  @unique @db.VarChar(10)
  enabled Boolean @default(true)

  @@map("languages")
}

model Role {
  id    String    @id @default(cuid())
  name  String    @unique @db.VarChar(40)
  perms Json
  users AppUser[]
}

model AppUser {
  id           String   @id @default(cuid())
  name         String   @db.VarChar(120)
  username     String   @unique @db.VarChar(64)
  passwordHash String   @db.VarChar(200)
  role         String   @db.VarChar(40)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())

  roleRef Role @relation(fields: [role], references: [name], onUpdate: Cascade, onDelete: Restrict)

  @@map("app_users")
}

model AuditLog {
  id          String   @id @default(cuid())
  time        DateTime @default(now())
  user        String   @db.VarChar(64)
  act         String   @db.VarChar(40)
  entity      String   @db.VarChar(80)
  description String?  @db.Text

  @@index([time])
  @@map("audit_logs")
}

model UserLog {
  id    String   @id @default(cuid())
  time  DateTime @default(now())
  user  String   @db.VarChar(64)
  act   String   @db.VarChar(80)

  @@index([time])
  @@map("user_logs")
}
